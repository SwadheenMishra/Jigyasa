# Optional. Without a key, Jigyasa uses its offline brain.
# With a key, it uses Google Gemini and falls back to the offline brain on any error or after 8 s.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_PROVIDER=gemini
# Optional model override (default: gemini-3.5-flash-lite)
GEMINI_MODEL=
